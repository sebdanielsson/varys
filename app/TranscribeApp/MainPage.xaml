<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="TranscribeApp.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:TranscribeApp"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Controls -->
        <StackPanel Orientation="Horizontal" Spacing="12">
            <ComboBox x:Name="LanguageBox" Header="Language" Width="170" SelectedIndex="0">
                <ComboBoxItem Content="Auto / English" Tag="auto" />
                <ComboBoxItem Content="English" Tag="en" />
                <ComboBoxItem Content="Swedish" Tag="sv" />
            </ComboBox>
            <Button x:Name="StartStopButton" Content="Start" MinWidth="90"
                    VerticalAlignment="Bottom" Click="OnStartStopClick"
                    Style="{StaticResource AccentButtonStyle}" />
            <TextBlock x:Name="StatusText" Text="idle" VerticalAlignment="Bottom" Margin="4,0,0,6"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <!-- Transcript (committed finals) -->
        <Border Grid.Row="1" CornerRadius="8" Padding="8"
                Background="{ThemeResource LayerFillColorDefaultBrush}">
            <ListView x:Name="Captions" ItemsSource="{x:Bind Items}" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:CaptionItem">
                        <Grid ColumnSpacing="10" Padding="4,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="52" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Bind Speaker}" Foreground="{x:Bind Color}"
                                       FontWeight="SemiBold" />
                            <TextBlock Grid.Column="1" Text="{x:Bind Text}" TextWrapping="Wrap"
                                       IsTextSelectionEnabled="True" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>

        <!-- Live partial line -->
        <TextBlock x:Name="PartialText" Grid.Row="2" FontStyle="Italic" TextWrapping="Wrap"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

        <!-- Diagnostics / last log line -->
        <TextBlock x:Name="LogText" Grid.Row="3" FontSize="11" TextTrimming="CharacterEllipsis"
                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
    </Grid>
</Page>

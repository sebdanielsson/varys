<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Varys.MeetingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Varys"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="16" ColumnSpacing="14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="290" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- LEFT: search + list -->
        <Grid RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <AutoSuggestBox x:Name="SearchBox" PlaceholderText="Search meetings…" QueryIcon="Find"
                            QuerySubmitted="OnSearchSubmitted" TextChanged="OnSearchTextChanged" />

            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <ToggleSwitch x:Name="SemanticToggle" MinWidth="0" IsOn="True"
                              OnContent="Semantic" OffContent="Keyword" />
                <ProgressRing x:Name="SearchRing" Width="16" Height="16" IsActive="False" />
            </StackPanel>

            <Grid Grid.Row="2">
                <ListView x:Name="MeetingsList" ItemsSource="{x:Bind Meetings}"
                          SelectionChanged="OnMeetingSelected">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:MeetingMeta">
                            <Grid Padding="2,7" ColumnSpacing="10" RightTapped="OnItemRightTapped">
                                <Grid.ContextFlyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem Text="Rename" Click="OnCtxRename">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8AC;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem Text="Summarize" Click="OnCtxSummarize">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8A5;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem Text="Open folder" Click="OnCtxOpenFolder">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE838;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutSeparator />
                                        <MenuFlyoutItem Text="Delete" Click="OnCtxDelete">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74D;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                    </MenuFlyout>
                                </Grid.ContextFlyout>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="{x:Bind Glyph}" FontSize="16" VerticalAlignment="Center"
                                          Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="{x:Bind Subtitle}" FontSize="11"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <ListView x:Name="ResultsList" Visibility="Collapsed" ItemsSource="{x:Bind Results}"
                          SelectionChanged="OnResultSelected">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:SearchHit">
                            <StackPanel Padding="2,7">
                                <TextBlock Text="{x:Bind Meeting.Title}" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind Text}" FontSize="12" TextWrapping="Wrap" MaxLines="2"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <TextBlock x:Name="ListEmpty" Text="No meetings yet." Visibility="Collapsed"
                           HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,24"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            </Grid>
        </Grid>

        <!-- RIGHT: detail -->
        <Grid Grid.Column="1">
            <StackPanel x:Name="DetailEmpty" VerticalAlignment="Center" HorizontalAlignment="Center"
                        Spacing="8">
                <FontIcon Glyph="&#xE8F1;" FontSize="36"
                          Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                <TextBlock Text="Select a meeting to view its transcript and notes"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <Grid x:Name="DetailContent" Visibility="Collapsed" RowSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="DetailTitle" FontSize="20" FontWeight="SemiBold"
                                   TextWrapping="Wrap" DoubleTapped="OnTitleDoubleTapped"
                                   ToolTipService.ToolTip="Double-click to rename" />
                        <TextBlock x:Name="DetailSubtitle" FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Top">
                        <Button Click="OnRenameMeeting" ToolTipService.ToolTip="Rename meeting">
                            <FontIcon Glyph="&#xE8AC;" FontSize="16" />
                        </Button>
                        <Button x:Name="SummarizeBtn" Click="OnSummarizeMeeting"
                                ToolTipService.ToolTip="Generate notes (summarize)">
                            <FontIcon Glyph="&#xE8A5;" FontSize="16" />
                        </Button>
                        <Button Click="OnOpenFolder" ToolTipService.ToolTip="Open meeting folder">
                            <FontIcon Glyph="&#xE838;" FontSize="16" />
                        </Button>
                        <Button Click="OnDeleteMeeting" ToolTipService.ToolTip="Delete meeting (to trash)">
                            <FontIcon Glyph="&#xE74D;" FontSize="16" />
                        </Button>
                    </StackPanel>
                </Grid>

                <Border Grid.Row="1" x:Name="SummaryCard" Visibility="Collapsed" CornerRadius="8"
                        Padding="12" Background="{ThemeResource LayerFillColorDefaultBrush}">
                    <Grid RowSpacing="6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Notes" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <Button Grid.Column="1" x:Name="NotesEditBtn" Click="OnToggleNotesEdit"
                                    ToolTipService.ToolTip="Edit notes" Padding="7,3">
                                <FontIcon Glyph="&#xE70F;" FontSize="14" />
                            </Button>
                        </Grid>
                        <Grid Grid.Row="1">
                            <WebView2 x:Name="NotesWeb" Height="60" />
                            <TextBox x:Name="NotesEdit" Visibility="Collapsed" AcceptsReturn="True"
                                     TextWrapping="Wrap" Height="220" FontFamily="Cascadia Mono, Consolas" />
                        </Grid>
                    </Grid>
                </Border>

                <Border Grid.Row="2" CornerRadius="8" Padding="4"
                        Background="{ThemeResource LayerFillColorDefaultBrush}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Padding="8,6,8,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Transcript" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <Button Grid.Column="1" x:Name="TranscriptEditBtn" Click="OnToggleTranscriptEdit"
                                    ToolTipService.ToolTip="Edit transcript" Padding="7,3">
                                <FontIcon Glyph="&#xE70F;" FontSize="14" />
                            </Button>
                        </Grid>
                        <Grid Grid.Row="1">
                            <ListView x:Name="DetailTranscript" ItemsSource="{x:Bind DetailUtterances}"
                                      SelectionMode="None" Padding="6">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="local:CaptionItem">
                                        <Grid ColumnSpacing="10" Padding="2,5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Background="{x:Bind Color}" CornerRadius="10" Height="22"
                                                    Padding="9,0" MinWidth="56" VerticalAlignment="Top">
                                                <TextBlock Text="{x:Bind Speaker}" Foreground="White" FontSize="12"
                                                           FontWeight="SemiBold" HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="{x:Bind Text}" TextWrapping="Wrap"
                                                       IsTextSelectionEnabled="True" VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <TextBox x:Name="TranscriptEdit" Visibility="Collapsed" AcceptsReturn="True"
                                     TextWrapping="Wrap" FontFamily="Cascadia Mono, Consolas" Margin="6" />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <ProgressRing x:Name="DetailRing" IsActive="False" Width="28" Height="28"
                          HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,12" />
        </Grid>
    </Grid>
</Page>

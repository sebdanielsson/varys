<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="Varys.OllamaGreeterDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Varys"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Set up Ollama"
    CloseButtonText="Not now"
    DefaultButton="Primary"
    PrimaryButtonClick="OnPrimaryClick"
    SecondaryButtonClick="OnSecondaryClick">

    <StackPanel Width="440" Spacing="14">
        <TextBlock x:Name="Body" TextWrapping="Wrap" />

        <StackPanel x:Name="Features" Spacing="9">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <FontIcon Glyph="&#xE8A5;" FontSize="16"
                          Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                <TextBlock Text="Meeting summaries &amp; action items (local LLM)" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="10">
                <FontIcon Glyph="&#xE721;" FontSize="16"
                          Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                <TextBlock Text="Semantic search across your meetings" VerticalAlignment="Center" />
            </StackPanel>
        </StackPanel>

        <InfoBar x:Name="Status" IsOpen="False" IsClosable="False" />
        <ProgressBar x:Name="Progress" IsIndeterminate="True" Visibility="Collapsed" />

        <TextBlock x:Name="Footnote" TextWrapping="Wrap" FontSize="12"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   Text="Everything runs locally — Ollama serves a model on your machine, nothing is sent to the cloud." />
    </StackPanel>
</ContentDialog>

<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="Varys.WelcomeDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Varys"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Welcome to Varys"
    CloseButtonText="Close"
    DefaultButton="None">

    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="560">
        <StackPanel Width="470" Spacing="16">
            <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Text="A few one-time steps and you're ready to transcribe meetings — everything runs locally on your machine." />

            <!-- Transcription engine -->
            <Border Background="{ThemeResource SolidBackgroundFillColorTertiaryBrush}" CornerRadius="8" Padding="14">
                <StackPanel Spacing="10">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE713;" FontSize="20" VerticalAlignment="Center"
                                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Transcription engine" FontWeight="SemiBold" />
                            <TextBlock x:Name="EngineStatus" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <Button x:Name="EngineBtn" Grid.Column="2" Content="Set up" VerticalAlignment="Center"
                                Style="{ThemeResource AccentButtonStyle}" Click="OnSetupEngine" />
                    </Grid>
                    <ProgressBar x:Name="EngineProgress" IsIndeterminate="True" Visibility="Collapsed" />
                </StackPanel>
            </Border>

            <!-- Ollama -->
            <Border Background="{ThemeResource SolidBackgroundFillColorTertiaryBrush}" CornerRadius="8" Padding="14">
                <StackPanel Spacing="10">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE8A5;" FontSize="20" VerticalAlignment="Center"
                                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Ollama — summaries &amp; search" FontWeight="SemiBold" />
                            <TextBlock x:Name="OllamaStatus" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <StackPanel x:Name="OllamaButtons" Grid.Column="2" Orientation="Horizontal" Spacing="6"
                                    VerticalAlignment="Center">
                            <Button x:Name="OllamaInstallBtn" Content="Install" Click="OnInstallOllama"
                                    Style="{ThemeResource AccentButtonStyle}" />
                            <Button x:Name="OllamaWebBtn" Content="Website" Click="OnOpenOllamaSite" />
                        </StackPanel>
                    </Grid>
                    <ProgressBar x:Name="OllamaProgress" IsIndeterminate="True" Visibility="Collapsed" />
                </StackPanel>
            </Border>

            <!-- Models (revealed once Ollama is detected) -->
            <Border x:Name="ModelsSection" Background="{ThemeResource SolidBackgroundFillColorTertiaryBrush}"
                    CornerRadius="8" Padding="14" Visibility="Collapsed">
                <StackPanel Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon Glyph="&#xE896;" FontSize="20" VerticalAlignment="Center"
                                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        <StackPanel>
                            <TextBlock Text="Models" FontWeight="SemiBold" />
                            <TextBlock Text="Download each model Varys uses (one-time)." FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel x:Name="ModelsHost" Spacing="4" />
                </StackPanel>
            </Border>

            <InfoBar x:Name="Status" IsOpen="False" IsClosable="False" />
        </StackPanel>
    </ScrollViewer>
</ContentDialog>

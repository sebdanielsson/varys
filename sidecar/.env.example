# Copy to .env and adjust. All keys are prefixed TRANSCRIBE_.
# TRANSCRIBE_DEVICE=auto                 # auto | cuda | cpu
# TRANSCRIBE_LANGUAGE=auto               # auto|en -> Parakeet;  sv -> KB-Whisper (forced)
# TRANSCRIBE_WHISPER_COMPUTE_TYPE=float16  # float16 | int8_float16 | int8 (lower VRAM)
# TRANSCRIBE_PORT=8765
# TRANSCRIBE_SUMMARY_MODEL=gemma4:e2b    # verify exact Ollama tag at Phase 5
